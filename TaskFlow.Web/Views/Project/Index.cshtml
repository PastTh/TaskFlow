@model List<TaskFlow.Application.DTOs.ProjectDto>
@{
    ViewData["Title"] = "Projects";
    var workspaceId = ViewBag.WorkspaceId;
}

<h2>Projects</h2>

<form asp-action="Create" method="post" class="row g-2 mb-4">
    <input type="hidden" name="workspaceId" value="@workspaceId" />
    <div class="col-auto">
        <input type="text" name="name" class="form-control" placeholder="New project name" required />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Create</button>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">No projects yet.</div>
}
else
{
    <table class="table table-hover">
        <thead><tr><th>Name</th><th>Created</th><th></th></tr></thead>
        <tbody>
            @foreach (var project in Model)
            {
                <tr>
                    <td><a asp-controller="Task" asp-action="Index" asp-route-projectId="@project.Id">@project.Name</a></td>
                    <td>@project.CreatedAt.ToString("dd MMM yyyy")</td>
                    <td class="text-end">
                        <form asp-action="Delete" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@project.Id" />
                            <input type="hidden" name="workspaceId" value="@workspaceId" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}